@page "/administracion/ausencias"
@attribute [Authorize(Roles = "Administrador")]

@using NSControlHorarioApp.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NSControlHorario.Data
@using NSControlHorarioApp.Services
@using static NSControlHorarioApp.Models.Ausencia

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificacionService NotificacionService


<PageTitle>Gestión de ausencias</PageTitle>

<h3>Gestión de ausencias</h3>

<p class="text-muted">
    Administración de vacaciones, bajas médicas y permisos de los empleados.
</p>

<div class="card mt-4">
    <div class="card-header">
        <strong>Ausencias registradas</strong>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Filtrar por empleado</label>
            <InputSelect class="form-select" @bind-Value="filtroEmpleado">
                <option value="">Todos los empleados</option>

                @foreach (var empleado in empleados)
                {
                    <option value="@empleado.Id">
                        @empleado.Nombre @empleado.Apellidos
                    </option>
                }
            </InputSelect>
        </div>

        @if (ausenciasRegistradas.Count == 0)
        {
            <p class="text-muted mb-0">No hay ausencias registradas.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Empleado</th>
                            <th>Tipo</th>
                            <th>Periodo</th>
                            <th>Observaciones</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ausencia in ausenciasRegistradas.Where(a => string.IsNullOrEmpty(filtroEmpleado) || a.UserId == filtroEmpleado))
                        {
                            <tr>
                                <td>
                                    @ausencia.Usuario?.Nombre
                                    @ausencia.Usuario?.Apellidos
                                </td>
                                <td>@ausencia.Tipo</td>
                                <td>@FormatearPeriodo(ausencia)</td>
                                <td>@ausencia.Observaciones</td>
                                <td>
                                    @switch (ausencia.Estado)
                                    {
                                        case EstadoAusencia.Pendiente:
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                            break;

                                        case EstadoAusencia.Aceptada:
                                            <span class="badge bg-success">Aceptada</span>
                                            break;

                                        case EstadoAusencia.Denegada:
                                            <span class="badge bg-danger">Denegada</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (ausencia.Estado == EstadoAusencia.Pendiente)
                                    {
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-success"
                                                    @onclick="() => AceptarAusencia(ausencia.Id)">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Aceptar
                                            </button>

                                            <button class="btn btn-sm btn-danger"
                                                    @onclick="() => DenegarAusencia(ausencia.Id)">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Denegar
                                            </button>
                                        </div>
                                    }
                                    else if (ausencia.Estado == EstadoAusencia.Denegada)
                                    {
                                        <span>@ausencia.MotivoResolucion</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Resuelta</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (mostrarFormularioDenegacion)
{
    <div class="card mt-3 border-danger">
        <div class="card-header">
            <strong>Denegar solicitud de ausencia</strong>
        </div>

        <div class="card-body">
            <label class="form-label">Motivo de la denegación</label>

            <InputTextArea class="form-control"
                           @bind-Value="motivoDenegacion"
                           rows="3"
                           maxlength="500" />

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-danger"
                        @onclick="ConfirmarDenegacion">
                    Confirmar denegación
                </button>

                <button class="btn btn-secondary"
                        @onclick="CancelarDenegacion">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {

    private List<ApplicationUser> empleados = new();

    private string filtroEmpleado = string.Empty;
    private List<Ausencia> ausenciasRegistradas = new();

    private bool mostrarFormularioDenegacion = false;
    private int? ausenciaDenegandoId = null;
    private string motivoDenegacion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        empleados = await UserManager.Users
            .Where(u => u.Activo)
            .OrderBy(u => u.Apellidos)
            .ThenBy(u => u.Nombre)
            .ToListAsync();

        await CargarAusencias();
    }

    private async Task CargarAusencias()
    {
        ausenciasRegistradas = await DbContext.Ausencias
            .Include(a => a.Usuario)
            .OrderByDescending(a => a.FechaInicioUtc)
            .ToListAsync();
    }

    private string FormatearPeriodo(Ausencia ausencia)
    {
        var zonaMadrid = TimeZoneInfo.FindSystemTimeZoneById(
            "Romance Standard Time");

        var inicio = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(ausencia.FechaInicioUtc, DateTimeKind.Utc),
            zonaMadrid);

        var fin = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(ausencia.FechaFinUtc, DateTimeKind.Utc),
            zonaMadrid);

        if (ausencia.Tipo == TipoAusencia.Vacaciones)
        {
            fin = fin.AddDays(-1);

            return $"{inicio:dd/MM/yyyy} - {fin:dd/MM/yyyy}";
        }

        return $"{inicio:dd/MM/yyyy HH:mm} - {fin:dd/MM/yyyy HH:mm}";
    }

    private async Task AceptarAusencia(int id)
    {
        var ausencia = await DbContext.Ausencias
            .FirstOrDefaultAsync(a =>
                a.Id == id &&
                a.Estado == EstadoAusencia.Pendiente);

        if (ausencia == null)
        {
            NotificacionService.Mostrar(
                "La solicitud no existe o ya ha sido resuelta.",
                "warning");
            return;
        }

        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var administrador = await UserManager.GetUserAsync(estado.User);

        if (administrador == null)
        {
            NotificacionService.Mostrar(
                "No se ha podido identificar al administrador.",
                "error");
            return;
        }

        ausencia.Estado = EstadoAusencia.Aceptada;
        ausencia.UsuarioResolucionId = administrador.Id;
        ausencia.FechaResolucionUtc = DateTime.UtcNow;
        ausencia.MotivoResolucion = null;

        await DbContext.SaveChangesAsync();

        await CargarAusencias();

        NotificacionService.Mostrar(
            "Solicitud de ausencia aceptada correctamente.",
            "success");
    }

    private void DenegarAusencia(int id)
    {
        ausenciaDenegandoId = id;
        motivoDenegacion = string.Empty;
        mostrarFormularioDenegacion = true;
    }

    private async Task ConfirmarDenegacion()
    {
        if (!ausenciaDenegandoId.HasValue)
            return;

        if (string.IsNullOrWhiteSpace(motivoDenegacion))
        {
            NotificacionService.Mostrar(
                "Debes indicar el motivo de la denegación.",
                "warning");
            return;
        }

        var ausencia = await DbContext.Ausencias
            .FirstOrDefaultAsync(a =>
                a.Id == ausenciaDenegandoId.Value &&
                a.Estado == EstadoAusencia.Pendiente);

        if (ausencia == null)
        {
            NotificacionService.Mostrar(
                "La solicitud no existe o ya ha sido resuelta.",
                "warning");

            CancelarDenegacion();
            return;
        }

        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var administrador = await UserManager.GetUserAsync(estado.User);

        if (administrador == null)
        {
            NotificacionService.Mostrar(
                "No se ha podido identificar al administrador.",
                "error");
            return;
        }

        ausencia.Estado = EstadoAusencia.Denegada;
        ausencia.UsuarioResolucionId = administrador.Id;
        ausencia.FechaResolucionUtc = DateTime.UtcNow;
        ausencia.MotivoResolucion = motivoDenegacion.Trim();

        await DbContext.SaveChangesAsync();

        CancelarDenegacion();

        await CargarAusencias();

        NotificacionService.Mostrar(
            "Solicitud de ausencia denegada correctamente.",
            "success");
    }

    private void CancelarDenegacion()
    {
        mostrarFormularioDenegacion = false;
        ausenciaDenegandoId = null;
        motivoDenegacion = string.Empty;
    }


}