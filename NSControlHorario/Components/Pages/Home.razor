@page "/"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

@code {
    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (estado.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/mi-fichaje", replace: true);
        }
        else
        {
            NavigationManager.NavigateTo("/Account/Login", replace: true);
        }
    }
}