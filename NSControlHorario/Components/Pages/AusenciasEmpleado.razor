@page "/ausencias"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NSControlHorario.Data
@using NSControlHorarioApp.Models
@using NSControlHorarioApp.Services
@using static NSControlHorarioApp.Models.Ausencia

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificacionService NotificacionService


<PageTitle>Mis ausencias</PageTitle>

<h3>Mis ausencias</h3>

<p class="text-muted">
    Consulta y gestiona tus solicitudes de vacaciones, bajas médicas y permisos.
</p>

<button class="btn btn-primary mt-3"
        @onclick="MostrarFormulario">
    <i class="bi bi-plus-circle me-1"></i>
    Nueva solicitud
</button>

@if (mostrarFormulario)
{
    <div class="card mt-4">

        <h5 class="card-title">
            @(ausenciaEditandoId.HasValue
                ? "Editar solicitud de ausencia"
                : "Nueva solicitud de ausencia")
        </h5>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Tipo de ausencia</label>
                    <InputSelect class="form-select" @bind-Value="tipoSeleccionado">
                        @foreach (var tipo in Enum.GetValues<TipoAusencia>())
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha de inicio</label>
                    <InputDate class="form-control" @bind-Value="fechaInicio" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha de fin</label>
                    <InputDate class="form-control" @bind-Value="fechaFin" />
                </div>

                @if (tipoSeleccionado != TipoAusencia.Vacaciones)
                {
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hora de inicio</label>
                        <input type="text"
                               class="form-control"
                               @bind="horaInicio"
                               placeholder="HH:mm"
                               maxlength="5" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hora de fin</label>
                        <input type="text"
                               class="form-control"
                               @bind="horaFin"
                               placeholder="HH:mm"
                               maxlength="5" />
                    </div>
                }

                <div class="col-12 mb-3">
                    <label class="form-label">Observaciones</label>
                    <InputTextArea class="form-control"
                                   @bind-Value="observaciones"
                                   rows="3" />
                </div>

            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="GuardarAusencia">
                    @(ausenciaEditandoId.HasValue ? "Guardar cambios" : "Enviar solicitud")
                </button>

                <button class="btn btn-secondary" @onclick="CancelarFormulario">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

<div class="card mt-4">
    <div class="card-header">
        <strong>Mis solicitudes</strong>
    </div>

    <div class="card-body">
        @if (misAusencias.Count == 0)
        {
            <p class="text-muted mb-0">
                Todavía no tienes solicitudes de ausencia.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Periodo</th>
                            <th>Observaciones</th>
                            <th>Estado</th>
                            <th>Resolución</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ausencia in misAusencias)
                        {
                            <tr>
                                <td>@ausencia.Tipo</td>
                                <td>@FormatearPeriodo(ausencia)</td>
                                <td>@ausencia.Observaciones</td>
                                <td>
                                    @switch (ausencia.Estado)
                                    {
                                        case EstadoAusencia.Pendiente:
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                            break;

                                        case EstadoAusencia.Aceptada:
                                            <span class="badge bg-success">Aceptada</span>
                                            break;

                                        case EstadoAusencia.Denegada:
                                            <span class="badge bg-danger">Denegada</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (ausencia.Estado == EstadoAusencia.Denegada)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(ausencia.MotivoResolucion))
                                        {
                                            <span>@ausencia.MotivoResolucion</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin motivo indicado</span>
                                        }
                                    }
                                    else if (ausencia.Estado == EstadoAusencia.Aceptada)
                                    {
                                        <span class="text-success">Solicitud aprobada</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pendiente de resolución</span>
                                    }
                                </td>
                                <td>
                                    @if (ausencia.Estado == EstadoAusencia.Pendiente)
                                    {
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => EditarAusencia(ausencia.Id)">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private string userId = "";
    private List<Ausencia> misAusencias = new();

    private bool mostrarFormulario = false;

    private TipoAusencia tipoSeleccionado = TipoAusencia.Vacaciones;
    private DateTime fechaInicio = DateTime.Today;
    private DateTime fechaFin = DateTime.Today;

    private string horaInicio = "09:00";
    private string horaFin = "14:00";
    private string observaciones = "";

    private int? ausenciaEditandoId = null;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = estado.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        if (!string.IsNullOrEmpty(userId))
        {
            await CargarAusencias();
        }
    }

    private async Task CargarAusencias()
    {
        misAusencias = await DbContext.Ausencias
            .Where(a => a.UserId == userId)
            .OrderByDescending(a => a.FechaInicioUtc)
            .ToListAsync();
    }

    private string FormatearPeriodo(Ausencia ausencia)
    {
        var zonaMadrid = TimeZoneInfo.FindSystemTimeZoneById(
            "Romance Standard Time");

        var inicio = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(ausencia.FechaInicioUtc, DateTimeKind.Utc),
            zonaMadrid);

        var fin = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(ausencia.FechaFinUtc, DateTimeKind.Utc),
            zonaMadrid);

        if (ausencia.Tipo == TipoAusencia.Vacaciones)
        {
            fin = fin.AddDays(-1);
            return $"{inicio:dd/MM/yyyy} - {fin:dd/MM/yyyy}";
        }

        return $"{inicio:dd/MM/yyyy HH:mm} - {fin:dd/MM/yyyy HH:mm}";
    }

    private void MostrarFormulario()
    {
        ausenciaEditandoId = null;

        tipoSeleccionado = TipoAusencia.Vacaciones;
        fechaInicio = DateTime.Today;
        fechaFin = DateTime.Today;
        horaInicio = "09:00";
        horaFin = "14:00";
        observaciones = "";

        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;

        tipoSeleccionado = TipoAusencia.Vacaciones;
        fechaInicio = DateTime.Today;
        fechaFin = DateTime.Today;
        horaInicio = "09:00";
        horaFin = "14:00";
        observaciones = "";
        ausenciaEditandoId = null;
    }

    private async Task GuardarAusencia()
    {
        if (string.IsNullOrEmpty(userId))
        {
            NotificacionService.Mostrar(
                "No se ha podido identificar al empleado.",
                "error");
            return;
        }

        if (fechaFin.Date < fechaInicio.Date)
        {
            NotificacionService.Mostrar(
                "La fecha de fin no puede ser anterior a la fecha de inicio.",
                "warning");
            return;
        }

        DateTime inicioLocal;
        DateTime finLocal;

        if (tipoSeleccionado == TipoAusencia.Vacaciones)
        {
            inicioLocal = fechaInicio.Date;
            finLocal = fechaFin.Date.AddDays(1);
        }
        else
        {
            if (!TimeSpan.TryParseExact(
                horaInicio,
                @"hh\:mm",
                System.Globalization.CultureInfo.InvariantCulture,
                out TimeSpan horaInicioSpan))
            {
                NotificacionService.Mostrar(
                    "La hora de inicio no es válida. Utiliza HH:mm.",
                    "warning");
                return;
            }

            if (!TimeSpan.TryParseExact(
                horaFin,
                @"hh\:mm",
                System.Globalization.CultureInfo.InvariantCulture,
                out TimeSpan horaFinSpan))
            {
                NotificacionService.Mostrar(
                    "La hora de fin no es válida. Utiliza HH:mm.",
                    "warning");
                return;
            }

            inicioLocal = fechaInicio.Date.Add(horaInicioSpan);
            finLocal = fechaFin.Date.Add(horaFinSpan);

            if (finLocal <= inicioLocal)
            {
                NotificacionService.Mostrar(
                    "La fecha y hora de fin deben ser posteriores a las de inicio.",
                    "warning");
                return;
            }
        }

        var zonaMadrid = TimeZoneInfo.FindSystemTimeZoneById(
            "Romance Standard Time");

        var inicioUtc = TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(inicioLocal, DateTimeKind.Unspecified),
            zonaMadrid);

        var finUtc = TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(finLocal, DateTimeKind.Unspecified),
            zonaMadrid);

        Ausencia? ausencia;

        if (ausenciaEditandoId.HasValue)
        {
            ausencia = await DbContext.Ausencias
                .FirstOrDefaultAsync(a =>
                    a.Id == ausenciaEditandoId.Value &&
                    a.UserId == userId &&
                    a.Estado == EstadoAusencia.Pendiente);

            if (ausencia == null)
            {
                NotificacionService.Mostrar(
                    "La solicitud ya no existe o no se puede modificar.",
                    "warning");
                return;
            }

            ausencia.Tipo = tipoSeleccionado;
            ausencia.FechaInicioUtc = inicioUtc;
            ausencia.FechaFinUtc = finUtc;
            ausencia.Observaciones = observaciones;
        }
        else
        {
            ausencia = new Ausencia
                {
                    UserId = userId,
                    Tipo = tipoSeleccionado,
                    FechaInicioUtc = inicioUtc,
                    FechaFinUtc = finUtc,
                    Observaciones = observaciones,
                    UsuarioRegistroId = userId,
                    FechaRegistroUtc = DateTime.UtcNow,
                    Estado = EstadoAusencia.Pendiente
                };

            DbContext.Ausencias.Add(ausencia);
        }

        await DbContext.SaveChangesAsync();

        var mensaje = ausenciaEditandoId.HasValue ? "Solicitud de ausencia modificada correctamente." : "Solicitud de ausencia enviada correctamente. Está pendiente de aprobación.";

        NotificacionService.Mostrar(mensaje, "success");

        mostrarFormulario = false;
        ausenciaEditandoId = null;

        await CargarAusencias();
    }

    private async Task EditarAusencia(int id)
    {
        var ausencia = await DbContext.Ausencias
            .FirstOrDefaultAsync(a =>
                a.Id == id &&
                a.UserId == userId &&
                a.Estado == EstadoAusencia.Pendiente);

        if (ausencia == null)
        {
            NotificacionService.Mostrar(
                "No se ha encontrado la solicitud o ya no se puede modificar.",
                "warning");
            return;
        }

        ausenciaEditandoId = ausencia.Id;
        tipoSeleccionado = ausencia.Tipo;
        observaciones = ausencia.Observaciones;

        var zonaMadrid = TimeZoneInfo.FindSystemTimeZoneById(
            "Romance Standard Time");

        var inicioLocal = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(ausencia.FechaInicioUtc, DateTimeKind.Utc),
            zonaMadrid);

        var finLocal = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(ausencia.FechaFinUtc, DateTimeKind.Utc),
            zonaMadrid);

        fechaInicio = inicioLocal.Date;

        if (ausencia.Tipo == TipoAusencia.Vacaciones)
        {
            fechaFin = finLocal.Date.AddDays(-1);
        }
        else
        {
            fechaFin = finLocal.Date;
            horaInicio = inicioLocal.ToString("HH:mm");
            horaFin = finLocal.ToString("HH:mm");
        }

        mostrarFormulario = true;
    }

    

}