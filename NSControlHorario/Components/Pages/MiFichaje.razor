@page "/mi-fichaje"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NSControlHorario.Data
@using NSControlHorarioApp.Models
@using NSControlHorarioApp.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject FichajeService FichajeService
@inject ApplicationDbContext DbContext
@inject ModificacionFichajeService ModificacionFichajeService
@inject NotificacionService NotificacionService

<PageTitle>Mi fichaje</PageTitle>

@if (cargando)
{
    <p>Consultando estado...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
        
    <div class="card shadow-sm p-5 mb-4 text-center"
     style="border: none; border-radius: 18px; background: linear-gradient(135deg, #ffffff 0%, #f0f5ff 100%);">
        <h5 class="text-muted mb-3">MI JORNADA</h5>

        @if (ultimoFichaje == null || ultimoFichaje.Tipo == TipoFichaje.Salida)
        {
            <div class="display-2 fw-bold text-secondary mb-3" style="font-variant-numeric: tabular-nums;">
                00:00:00
            </div>

            <span class="badge bg-secondary mb-4">Fuera de jornada</span>

            <div>
                <button class="btn btn-success btn-lg px-5"
                        @onclick="() => Registrar(TipoFichaje.Entrada)">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Registrar entrada
                </button>
            </div>
        }
        else
        {
            <div class="text-muted mb-2">Tiempo trabajado</div>

            <div class="display-2 fw-bold text-primary mb-3"
                 style="font-variant-numeric: tabular-nums;">
                @TiempoTrabajado.ToString(@"hh\:mm\:ss")
            </div>

            <span class="badge bg-success mb-4">Jornada en curso</span>

            <p class="mb-4">
                <i class="bi bi-clock me-2"></i>
                Entrada registrada:
                <strong>
                    @ConvertirHoraMadrid(ultimoFichaje.FechaHoraUtc).ToString("dd/MM/yyyy HH:mm:ss")
                </strong>
            </p>

            <div>
                <button class="btn btn-danger btn-lg px-5"
                        @onclick="() => Registrar(TipoFichaje.Salida)">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    Registrar salida
                </button>
            </div>
        }
    </div>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">
            <i class="bi bi-clock-history me-2 text-primary"></i>
            Mi historial de fichajes
        </h5>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label>Desde:</label>
            <input type="date" class="form-control" @bind="fechaDesde" />
        </div>

        <div class="col-md-4">
            <label>Hasta:</label>
            <input type="date" class="form-control" @bind="fechaHasta" />
        </div>

        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary" @onclick="BuscarHistorial">
                Buscar
            </button>

            <button class="btn btn-secondary" @onclick="LimpiarFiltros">
                Limpiar
            </button>
        </div>
    </div>

    @if (fichajeEditando != null)
    {
        <div class="card shadow-sm border-primary p-3 mb-3">
            <h5>Modificar fichaje</h5>

            <div class="row align-items-end mb-3">
                <div class="col-md-4">
                    <label>Fecha:</label>
                    <input type="date"
                           class="form-control"
                           @bind="fechaEdicion" />
                </div>

                <div class="col-md-2">
                    <label>Hora:</label>
                    <input type="text"
                           class="form-control"
                           @bind="horaEdicion"
                           placeholder="HH:mm"
                           maxlength="5" />
                </div>

                <div class="col-md-2">
                    <label>Tipo:</label>
                    <select class="form-select" @bind="tipoEdicion">
                        <option value="@TipoFichaje.Entrada">Entrada</option>
                        <option value="@TipoFichaje.Salida">Salida</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary"
                            @onclick="GuardarModificacion">
                        <i class="bi bi-check-circle me-1"></i>
                        Guardar cambios
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="CancelarEdicion">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Motivo de la modificación <span class="text-danger">*</span>
                </label>
                <textarea class="form-control"
                    rows="3"
                    maxlength="500"
                    placeholder="Explica el motivo de la modificación..."
                    @bind="motivoEdicion"></textarea>
            </div>

        </div>
    }

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Fecha y hora</th>
                    <th>Tipo</th>
                    <th>Acciones</th>
                    <th class="text-center text-nowrap" style="width: 110px;">Modificado</th>
                    <th>Motivo</th>
                    <th>Hora previa modificación</th>
                    <th>Fecha de modificación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fichaje in historial)
                {
                    <tr>
                        <td class="text-nowrap">@ConvertirHoraMadrid(fichaje.FechaHoraUtc).ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            @if (fichaje.Tipo == TipoFichaje.Entrada)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Entrada
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Salida
                                </span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => EditarFichaje(fichaje)"
                                    title="Modificar este fichaje">
                                <i class="bi bi-pencil-square me-1"></i>
                                Editar
                            </button>
                        </td>
                        <td class="text-center" style="width: 90px;">
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@fichajesModificados.Contains(fichaje.Id)"
                                   disabled />
                        </td>
                        <td>
                            @if (motivosUltimaModificacion.TryGetValue(fichaje.Id, out var motivo))
                            {
                                @motivo
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (fechasAnterioresModificacion.TryGetValue(fichaje.Id, out var fechaAnterior))
                            {
                                @ConvertirHoraMadrid(fechaAnterior).ToString("dd/MM/yyyy HH:mm:ss")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (fechasModificacion.TryGetValue(fichaje.Id, out var fechaModificacion))
                            {
                                @ConvertirHoraMadrid(fechaModificacion).ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">
                Página @paginaActual de @TotalPaginas
                · @totalFichajes fichajes
            </span>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm"
                        @onclick="PaginaAnterior"
                        disabled="@(paginaActual <= 1)">
                    <i class="bi bi-chevron-left me-1"></i>
                    Anterior
                </button>

                <button class="btn btn-outline-primary btn-sm"
                        @onclick="PaginaSiguiente"
                        disabled="@(paginaActual >= TotalPaginas)">
                    Siguiente
                    <i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>

}

@code {
    private string userId = "";
    private bool cargando = true;
    private string error = "";

    private Fichaje? ultimoFichaje;
    private DateTime ahoraMadrid = DateTime.Now;
    private System.Threading.Timer? temporizador;
    private List<Fichaje> historial = new();

    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private Fichaje? fichajeEditando;
    private DateTime fechaEdicion = DateTime.Today;
    private string horaEdicion = "09:00";
    private TipoFichaje tipoEdicion;
    private string motivoEdicion = "";

    private Dictionary<int, string> motivosUltimaModificacion = new();
    private Dictionary<int, DateTime> fechasAnterioresModificacion = new();
    private HashSet<int> fichajesModificados = new();
    private Dictionary<int, DateTime> fechasModificacion = new();

    private int paginaActual = 1;
    private const int registrosPorPagina = 20;
    private int totalFichajes = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var usuario = estado.User;

            if (usuario.Identity?.IsAuthenticated != true)
            {
                error = "Debes iniciar sesión.";
                return;
            }

            userId = usuario.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

            if (string.IsNullOrEmpty(userId))
            {
                error = "No se ha podido identificar al usuario.";
                return;
            }

            var hoyMadrid = TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                ZonaMadrid).Date;

            var diasDesdeLunes = ((int)hoyMadrid.DayOfWeek + 6) % 7;

            fechaDesde = hoyMadrid.AddDays(-diasDesdeLunes);
            fechaHasta = fechaDesde.Value.AddDays(6);

            await CargarDatos();

            temporizador = new System.Threading.Timer(
            ActualizarReloj,
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(1));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarDatos()
    {
        ultimoFichaje = await FichajeService.ObtenerUltimoFichajeAsync(userId);

        await CargarHistorial();
    }

    private async Task Registrar(TipoFichaje tipo)
    {

        var resultado = await FichajeService.RegistrarFichajeAsync(userId, tipo);

        NotificacionService.Mostrar(resultado.Mensaje, resultado.Correcto ? "success" : "error");

        if (resultado.Correcto)
        {
            await CargarDatos();
        }
    }

    private static readonly TimeZoneInfo ZonaMadrid =
    TimeZoneInfo.FindSystemTimeZoneById("Romance Standard Time");

    private static DateTime ConvertirHoraMadrid(DateTime fechaUtc)
    {
        fechaUtc = DateTime.SpecifyKind(fechaUtc, DateTimeKind.Utc);

        return TimeZoneInfo.ConvertTimeFromUtc(fechaUtc, ZonaMadrid);
    }

    private async Task CargarHistorial()
    {
        var consulta = DbContext.Fichajes
            .Where(f => f.UserId == userId);

        if (fechaDesde.HasValue)
        {
            var desdeMadrid = DateTime.SpecifyKind(
                fechaDesde.Value.Date,
                DateTimeKind.Unspecified);

            var desdeUtc = TimeZoneInfo.ConvertTimeToUtc(
                desdeMadrid, ZonaMadrid);

            consulta = consulta.Where(f => f.FechaHoraUtc >= desdeUtc);
        }

        if (fechaHasta.HasValue)
        {
            var hastaMadrid = DateTime.SpecifyKind(
                fechaHasta.Value.Date.AddDays(1),
                DateTimeKind.Unspecified);

            var hastaUtc = TimeZoneInfo.ConvertTimeToUtc(
                hastaMadrid, ZonaMadrid);

            consulta = consulta.Where(f => f.FechaHoraUtc < hastaUtc);
        }

        totalFichajes = await consulta.CountAsync();

        historial = await consulta
            .OrderByDescending(f => f.FechaHoraUtc)
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina)
            .ToListAsync();

        // Consultar las modificaciones de los fichajes obtenidos.
        var idsFichajes = historial.Select(f => f.Id).ToList();

        var modificaciones = await DbContext.ModificacionesFichajes
            .Where(m => idsFichajes.Contains(m.FichajeId))
            .OrderByDescending(m => m.FechaModificacionUtc)
            .ToListAsync();

        motivosUltimaModificacion.Clear();
        fechasAnterioresModificacion.Clear();
        fichajesModificados.Clear();
        fechasModificacion.Clear();

        foreach (var modificacion in modificaciones)
        {
            fichajesModificados.Add(modificacion.FichajeId);

            if (!motivosUltimaModificacion.ContainsKey(modificacion.FichajeId))
            {
                motivosUltimaModificacion.Add(
                    modificacion.FichajeId,
                    modificacion.Motivo);

                fechasAnterioresModificacion.Add(
                    modificacion.FichajeId,
                    modificacion.FechaHoraAnteriorUtc);

                fechasModificacion.Add(
                    modificacion.FichajeId,
                    modificacion.FechaModificacionUtc);
            }
        }
    }

    private async Task LimpiarFiltros()
    {
        fechaDesde = null;
        fechaHasta = null;
        paginaActual = 1;

        await CargarHistorial();
    }

    private void EditarFichaje(Fichaje fichaje)
    {
        fichajeEditando = fichaje;

        var fechaLocal = ConvertirHoraMadrid(fichaje.FechaHoraUtc);

        fechaEdicion = fechaLocal.Date;
        horaEdicion = fechaLocal.ToString("HH:mm");

        tipoEdicion = fichaje.Tipo;

        motivoEdicion = "";
    }

    private void CancelarEdicion()
    {
        fichajeEditando = null;
        motivoEdicion = "";
    }

    private async Task GuardarModificacion()
    {
        if (fichajeEditando == null)
            return;

        try
        {
            if (!TimeSpan.TryParseExact(
                    horaEdicion,
                    @"hh\:mm",
                    System.Globalization.CultureInfo.InvariantCulture,
                    out TimeSpan hora))
            {
                NotificacionService.Mostrar("La hora no es válida. Utiliza el formato HH:mm.","warning");

                return;
            }

            // Combinamos la fecha y la hora introducidas.
            var fechaMadrid = DateTime.SpecifyKind(
                fechaEdicion.Date.Add(hora),
                DateTimeKind.Unspecified);

            var fechaUtc = TimeZoneInfo.ConvertTimeToUtc(
                fechaMadrid,
                ZonaMadrid);

            // Obtenemos la identidad autenticada del servidor.
            var estado = await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

            var resultado = await ModificacionFichajeService.ModificarAsync(
                estado.User,
                fichajeEditando.Id,
                fechaUtc,
                tipoEdicion,
                motivoEdicion);

            NotificacionService.Mostrar(resultado.Mensaje, resultado.Correcto ? "success" : "error");

            if (resultado.Correcto)
            {
                fichajeEditando = null;
                motivoEdicion = "";

                await CargarDatos();
            }
        }
        catch (Exception ex)
        {
            NotificacionService.Mostrar("Error al modificar el fichaje: " + ex.Message, "error");
        }
    }

    private void ActualizarReloj(object? state)
    {
        _ = InvokeAsync(() =>
        {
            ahoraMadrid = TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                ZonaMadrid);

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        temporizador?.Dispose();
    }

    private TimeSpan TiempoTrabajado
    {
        get
        {
            if (ultimoFichaje == null ||
                ultimoFichaje.Tipo != TipoFichaje.Entrada)
            {
                return TimeSpan.Zero;
            }

            var entrada = ConvertirHoraMadrid(ultimoFichaje.FechaHoraUtc);

            return ahoraMadrid - entrada;
        }
    }

    private int TotalPaginas =>
    Math.Max(1, (int)Math.Ceiling((double)totalFichajes / registrosPorPagina));

    private async Task PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await CargarHistorial();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
            await CargarHistorial();
        }
    }

    private async Task BuscarHistorial()
    {
        paginaActual = 1;
        await CargarHistorial();
    }

}
